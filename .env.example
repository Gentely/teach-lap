# Phase 1 + Simple Gate — Server env only (Vercel → Settings → Environment Variables)
# Never commit real keys. Frontend must not read them.

GEMINI_API_KEY=your-gemini-api-key-here
# Optional: override model (default gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
# Simple access gate — one code for all teachers (fallback E-ENGLISH if not set)
ACCESS_CODE=E-ENGLISH

# ----------------------------------------------------------------------------
# SABRATHA ELT Tech-Assistant — environment variables
# ----------------------------------------------------------------------------
# Server-side ONLY (Vercel → Project → Settings → Environment Variables).
# Never expose GEMINI_API_KEY in frontend code!

# Google Gemini API key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Primary model (default: gemini-2.5-flash). Server auto-retries Gemini 3.x fallbacks if retired.
# If you see \"is no longer available\" errors, set GEMINI_MODEL=gemini-3.5-flash-lite in Vercel.
GEMINI_MODEL=gemini-2.5-flash

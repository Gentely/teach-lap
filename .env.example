# ----------------------------------------------------------------------------
# SABRATHA ELT Tech-Assistant — environment variables
# ----------------------------------------------------------------------------
# Server-side ONLY (Vercel → Project → Settings → Environment Variables).
# Never expose GEMINI_API_KEY in frontend code!

# Google Gemini API key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Primary model (default: gemini-2.5-flash). Server will auto-fallback to 2.0/1.5 if retired.
GEMINI_MODEL=gemini-2.5-flash
